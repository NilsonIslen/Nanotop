generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model City {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  country   String
  profiles  Profile[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Profile {
  id                String       @id @default(cuid())
  fullName          String
  cityId            String
  city              City         @relation(fields: [cityId], references: [id])
  country           String
  barrio            String       @default("")
  phoneNumber       String       @default("")
  walletAddress     String       @unique
  socialUrl         String?
  points            Int          @default(0)
  sentTransfers     Transfer[]   @relation("TransferSender")
  receivedTransfers Transfer[]   @relation("TransferReceiver")
  votesCast         Vote[]       @relation("VoteVoter")
  votesReceived     Vote[]       @relation("VoteReceiver")
  pointEvents       PointEvent[]
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([cityId, points])
}

model Transfer {
  id              String   @id @default(cuid())
  senderId        String
  sender          Profile  @relation("TransferSender", fields: [senderId], references: [id])
  receiverId      String
  receiver        Profile  @relation("TransferReceiver", fields: [receiverId], references: [id])
  amountNano      Decimal
  receiverAmount  Decimal
  platformFee     Decimal  @default(0)
  transactionHash String?
  vote            Vote?
  createdAt       DateTime @default(now())
}

model Vote {
  id         String      @id @default(cuid())
  type       VoteType
  voterId    String
  voter      Profile     @relation("VoteVoter", fields: [voterId], references: [id])
  receiverId String
  receiver   Profile     @relation("VoteReceiver", fields: [receiverId], references: [id])
  transferId String      @unique
  transfer   Transfer    @relation(fields: [transferId], references: [id])
  pointEvent PointEvent?
  createdAt  DateTime    @default(now())
}

model PointEvent {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id])
  voteId    String   @unique
  vote      Vote     @relation(fields: [voteId], references: [id])
  delta     Int
  before    Int
  after     Int
  createdAt DateTime @default(now())
}

enum VoteType {
  SELF_PROMOTION
  BURN
}
